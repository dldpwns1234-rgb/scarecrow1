extends "res://tests/test_case.gd"
## 낮과 밤의 전환, 생기, 바친 생기와 약속된 휴식, 밤 기록, 옛 저장 (GDD 3절)


func run() -> void:
	_fresh()
	_equal(Game.is_night(), false, "처음은 낮")
	Game.add_vitality(5.0)
	_close(Game.vitality, 0.0, "낮에는 생기를 받지 않는다")
	_equal(Game.finish_night(), false, "낮에는 밤을 끝낼 수 없다")
	_equal(Game.start_night(), true, "밤으로")
	_equal(Game.start_night(), false, "이미 밤")
	Game.add_vitality(3.0)
	Game.add_vitality(4.0)
	_close(Game.night_haul, 7.0, "이번 밤 생기")
	_close(Game.vitality, 7.0, "생기가 쌓인다")
	_equal(Game.finish_night(), true, "아침")
	_equal(Game.nights, 1, "밤 1번")
	_close(Game.last_haul, 7.0, "지난 밤 기록")
	_close(Game.best_haul, 7.0, "최고 기록")
	Game.start_night()
	Game.add_vitality(2.0)
	Game.finish_night()
	_close(Game.last_haul, 2.0, "지난 밤은 새 밤으로")
	_close(Game.best_haul, 7.0, "최고는 그대로")
	_equal(Game.spend(100.0), false, "모자라면 못 쓴다")
	_equal(Game.spend(4.0), true, "쓴다")
	_close(Game.vitality, 5.0, "남은 생기")
	_close(Game.offered, 9.0, "바친 생기 합은 쓴 것도 친다")
	_close(Balance.promised_rest_seconds(1000.0), 60.0 * pow(1000.0, Balance.PROMISE_EXPONENT), "생기 1천이면 10분 안팎")
	var first_winter := Balance.promised_rest_seconds(2e8)  # 봇의 첫 겨울잠 무렵 바친 생기 (docs/BALANCE_SIM.md)
	_equal(first_winter > 86400.0 and first_winter < 30.0 * 86400.0, true, "첫 겨울잠 무렵 며칠")
	_equal(Balance.promised_rest_seconds(1e18) < Balance.HUNDRED_YEARS_SECONDS, true, "1e18은 아직 백 년 전")
	_equal(Balance.promised_rest_seconds(1e19) > Balance.HUNDRED_YEARS_SECONDS, true, "1e19면 백 년을 넘는다 (봇은 넷째 철)")
	_close(Game.promised_rest_seconds(), Balance.promised_rest_seconds(9.0), "약속된 휴식은 바친 생기 합으로")
	Game.start_night()
	Game.add_vitality(1e308)
	Game.add_vitality(1e308)
	_equal(is_inf(Game.vitality) or is_inf(Game.offered), false, "생기는 상한에서 멈춘다")
	Game.finish_night()
	_close(Game.night_seconds(), Balance.NIGHT_BASE_SECONDS, "긴 밤이 없으면 기본 길이")
	# 저장: 옛 저장의 "rest"는 생기로 읽고, 바친 합이 없으면 지금 생기로 친다
	Game.from_dict({"rest": 42.0, "nights": 3})
	_close(Game.vitality, 42.0, "옛 저장의 휴식 = 생기")
	_close(Game.offered, 42.0, "바친 합이 없으면 지금 생기")
	Game.from_dict(Game.to_dict())
	_close(Game.vitality, 42.0, "저장 왕복")
	_equal(Game.nights, 3, "밤 수 복원")
	Game.from_dict({"vitality": 5.0, "offered": 2.0})
	_close(Game.offered, 5.0, "바친 합은 지금 생기보다 작지 않다")
	_fresh()
