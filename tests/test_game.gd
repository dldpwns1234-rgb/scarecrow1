extends "res://tests/test_case.gd"
## 낮과 밤의 전환, 휴식, 밤 기록 (GDD 3절)


func run() -> void:
	_fresh()
	_equal(Game.is_night(), false, "처음은 낮")
	Game.add_rest(5.0)
	_close(Game.rest, 0.0, "낮에는 휴식을 받지 않는다")
	_equal(Game.finish_night(), false, "낮에는 밤을 끝낼 수 없다")
	_equal(Game.start_night(), true, "밤으로")
	_equal(Game.start_night(), false, "이미 밤")
	Game.add_rest(3.0)
	Game.add_rest(4.0)
	_close(Game.night_haul, 7.0, "이번 밤 휴식")
	_close(Game.rest, 7.0, "휴식이 쌓인다")
	_equal(Game.finish_night(), true, "아침")
	_equal(Game.nights, 1, "밤 1번")
	_close(Game.last_haul, 7.0, "지난 밤 기록")
	_close(Game.best_haul, 7.0, "최고 기록")
	Game.start_night()
	Game.add_rest(2.0)
	Game.finish_night()
	_close(Game.last_haul, 2.0, "지난 밤은 새 밤으로")
	_close(Game.best_haul, 7.0, "최고는 그대로")
	_equal(Game.spend(100.0), false, "모자라면 못 쓴다")
	_equal(Game.spend(4.0), true, "쓴다")
	_close(Game.rest, 5.0, "남은 휴식")
	Game.start_night()
	Game.add_rest(1e308)
	Game.add_rest(1e308)
	_equal(is_inf(Game.rest), false, "휴식은 상한에서 멈춘다")
	Game.finish_night()
	_close(Game.night_seconds(), Balance.NIGHT_BASE_SECONDS, "긴 밤이 없으면 기본 길이")
	_fresh()
